# User Accounts
# This file creates sample users for testing LDAP integration
# All passwords are: password123 (hashed with SSHA)

# John Doe - Developer
dn: cn=john.doe,ou=users,dc=example,dc=com
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
cn: john.doe
sn: Doe
givenName: John
displayName: John Doe
uid: john.doe
uidNumber: 1001
gidNumber: 1001
homeDirectory: /home/john.doe
loginShell: /bin/bash
mail: john.doe@example.com
userPassword: {SSHA}YI/doPQ+kLbDUvewu+6AT1NGrdwmvm5m
description: Software Developer

